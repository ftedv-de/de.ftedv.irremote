{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "de.ftedv.irremote",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "IR Remote",
    "de": "IR-Fernbedienung"
  },
  "description": {
    "en": "Create, learn, control and back up your IR remotes",
    "de": "IR-Fernbedienungen erstellen, anlernen, steuern und sichern"
  },
  "category": [
    "tools"
  ],
  "permissions": [
    "homey:wireless:ir"
  ],
  "api": {
    "getRemotes": {
      "method": "GET",
      "path": "/remotes"
    },
    "addButton": {
      "method": "POST",
      "path": "/remotes/:deviceId/buttons"
    },
    "updateButton": {
      "method": "PUT",
      "path": "/remotes/:deviceId/buttons/:buttonId"
    },
    "deleteButton": {
      "method": "DELETE",
      "path": "/remotes/:deviceId/buttons/:buttonId"
    },
    "learnButton": {
      "method": "POST",
      "path": "/remotes/:deviceId/buttons/:buttonId/learn"
    },
    "sendButton": {
      "method": "POST",
      "path": "/remotes/:deviceId/buttons/:buttonId/send"
    },
    "getMqtt": {
      "method": "GET",
      "path": "/mqtt"
    },
    "setMqtt": {
      "method": "PUT",
      "path": "/mqtt"
    },
    "getDebug": {
      "method": "GET",
      "path": "/debug"
    },
    "setDebug": {
      "method": "PUT",
      "path": "/debug"
    },
    "runIrWordIndexDiagnostic": {
      "method": "POST",
      "path": "/debug/ir-word-index"
    },
    "getExport": {
      "method": "GET",
      "path": "/export"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Florian Trück",
    "email": "ftrueck@gmail.com"
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Send [[button]] with [[device]]",
          "de": "Sende [[button]] mit [[device]]"
        },
        "titleFormatted": {
          "en": "Send [[button]]",
          "de": "Sende [[button]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=ir_remote"
          },
          {
            "name": "button",
            "type": "autocomplete",
            "title": {
              "en": "Button",
              "de": "Taste"
            }
          }
        ],
        "id": "send_button"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "IR Remote",
        "de": "IR-Fernbedienung"
      },
      "class": "remote",
      "connectivity": [
        "infrared"
      ],
      "capabilities": [],
      "infrared": {
        "satelliteMode": true
      },
      "images": {
        "small": "/assets/images/small.png",
        "large": "/assets/images/large.png",
        "xlarge": "/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "configure"
        }
      ],
      "repair": [
        {
          "id": "manage_buttons"
        }
      ],
      "id": "ir_remote"
    }
  ],
